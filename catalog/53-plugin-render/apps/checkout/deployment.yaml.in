apiVersion: apps/v1
kind: Deployment
metadata:
  name: plugin-render
  namespace: cat-53
  labels:
    app.kubernetes.io/name: plugin-render
    app.kubernetes.io/part-of: checkout
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: plugin-render
  template:
    metadata:
      labels:
        app.kubernetes.io/name: plugin-render
    spec:
      containers:
      - name: podinfo
        image: ghcr.io/stefanprodan/podinfo:6.7.1
        command:
        - ./podinfo
        ports:
        - containerPort: 9898
          name: http
        resources:
          requests:
            memory: 16Mi
          limits:
            memory: MEMORY_LIMIT
